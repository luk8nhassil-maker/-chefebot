# Infraestrutura da Evolution API do ChefeBot — copie para ".env" no mesmo
# diretório (infra/evolution/.env) e preencha os valores reais. NUNCA
# commite o ".env" preenchido — ele já está no .gitignore da raiz do repo
# (confirme com `git check-ignore infra/evolution/.env`).

# ── Imagem da Evolution API ──────────────────────────────────────────────
# Tag EXATA — nunca "latest". Confira a versão real disponível em
# https://hub.docker.com/r/atendai/evolution-api/tags antes de definir.
EVOLUTION_IMAGE_TAG=v2.2.3

# ── Domínio e rede ────────────────────────────────────────────────────────
# Domínio próprio e estável (ver docs/WHATSAPP_INFRASTRUCTURE.md) — nunca
# um endereço gerado por PaaS (Railway, Render etc.).
EVOLUTION_DOMAIN=evolution.seudominio.com.br
# Opcional — deixe em branco para não expor o painel do Uptime Kuma.
UPTIME_KUMA_DOMAIN=status.seudominio.com.br

# Origens permitidas no CORS da Evolution API — só os domínios oficiais do
# ChefeBot que realmente chamam a API (nunca "*").
CHEFEBOT_ALLOWED_ORIGINS=https://chefebot-pjif.vercel.app

# Webhook oficial que a Evolution API deve chamar para eventos globais
# (o ChefeBot também configura o webhook por instância via /webhook/set,
# então este valor serve de referência/fallback).
CHEFEBOT_WEBHOOK_URL=https://chefebot-pjif.vercel.app/api/whatsapp

# ── Segredos (gere valores fortes e únicos, nunca reaproveite) ───────────
EVOLUTION_API_KEY=
POSTGRES_USER=evolution
POSTGRES_PASSWORD=
POSTGRES_DB=evolution
REDIS_PASSWORD=

# ── Diversos ──────────────────────────────────────────────────────────────
TZ=America/Sao_Paulo
EVOLUTION_LOG_LEVEL=ERROR,WARN

# ── Backup (scripts/backup.sh) ───────────────────────────────────────────
# Destino S3-compatível (ex.: Backblaze B2, Cloudflare R2, AWS S3). Nenhum
# desses valores deve ser commitado nem impresso em log.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_ENCRYPTION_PASSPHRASE=
