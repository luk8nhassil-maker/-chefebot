# Variáveis do bot WhatsApp (existentes)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ANTHROPIC_API_KEY=
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# ADMIN_PASSWORD=
# Canário de diagnóstico do WhatsApp (Etapa G) — único telefone autorizado
# a receber o teste real ponta-a-ponta via /dev/whatsapp. Nunca commitar o
# valor real aqui; configurar só em Production na Vercel.
# WHATSAPP_CANARY_PHONE=

# Guardião Pix server-side (QStash) — sem estas variáveis a cadeia fica
# desligada e o sistema cai de volta para webhook + polling do painel.
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# Opcional: sobrescreve a URL de callback do QStash (padrão usa VERCEL_URL
# ou https://chefebot-pjif.vercel.app).
# PIX_GUARDIAO_QSTASH_CALLBACK_URL=
# Opcional: paralelismo máximo (flowControl) do QStash para o endpoint do
# Guardião/Sentinela. Padrão 10 se ausente/inválida; 0 desativa o flowControl
# (rollback simples sem alterar lógica).
# PIX_GUARDIAO_QSTASH_FLOW_CONTROL_PARALLELISM=
