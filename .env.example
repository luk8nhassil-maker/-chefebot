# Variáveis do bot WhatsApp (existentes)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ANTHROPIC_API_KEY=
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# ADMIN_PASSWORD=
# Canário de diagnóstico do WhatsApp (Etapa G) — único telefone autorizado
# a receber o teste real ponta-a-ponta via /dev/whatsapp. Nunca commitar o
# valor real aqui; configurar só em Production na Vercel.
# WHATSAPP_CANARY_PHONE=

# Assinatura mensal do ChefeBot via Checkout Integrado InfinitePay.
# Em Production, ausente ou "false" mantém a cobrança operacional pausada:
# sem modal, sem bloqueio de novos pedidos e sem abertura de novo checkout.
# Preview/testes continuam podendo validar a UX sem cobrança real.
# Reative Production somente com opt-in explícito:
# ASSINATURA_CHEFEBOT_ENABLED=false
# Use EXCLUSIVAMENTE a InfiniteTag própria do ChefeBot/Chefe da Pizza,
# sem o símbolo $. Nunca reutilize credencial/conta de outro projeto.
# Sem esta variável a cobrança falha aberto e NÃO bloqueia a operação.
# Depois de adicionar ou alterar INFINITEPAY_HANDLE em Production, faça um
# novo deploy para o runtime carregar a configuração atualizada.
# INFINITEPAY_HANDLE=
# Opcional: URL pública canônica usada em redirect/webhook. Na Vercel o
# sistema usa VERCEL_PROJECT_PRODUCTION_URL automaticamente quando ausente.
# NEXT_PUBLIC_URL=

# Guardião Pix server-side (QStash) — sem estas variáveis a cadeia fica
# desligada e o sistema cai de volta para webhook + polling do painel.
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# Opcional: sobrescreve a URL de callback do QStash (padrão usa VERCEL_URL
# ou https://chefebot-pjif.vercel.app).
# PIX_GUARDIAO_QSTASH_CALLBACK_URL=
# Opcional: paralelismo máximo (flowControl) do QStash para o endpoint do
# Guardião/Sentinela. Padrão 10 se ausente/inválida; 0 desativa o flowControl
# (rollback simples sem alterar lógica).
# PIX_GUARDIAO_QSTASH_FLOW_CONTROL_PARALLELISM=

# Monitor preventivo de infraestrutura Railway (ver
# docs/operations/railway-infra-monitor.md) — painel /dev/mcp → "Saúde da
# Infraestrutura". RAILWAY_TOKEN NUNCA vai para a Vercel/este arquivo — vive
# só como GitHub Actions Secret, usado pelo workflow
# .github/workflows/railway-infra-monitor.yml.
#
# Segredo compartilhado entre o coletor (GitHub Actions Secret) e este app
# (Vercel Production e Preview) para validar a assinatura HMAC da ingestão.
# Nunca commitar o valor real.
# INFRA_METRICS_HMAC_SECRET=
#
# Feature flag: ausente ou "false" desativa a persistência da ingestão e a
# UI mostra "Monitor ainda não ativado". A rota de ingestão sempre exige
# HMAC válido, independente desta flag.
# DEV_INFRA_MONITOR_ENABLED=
#
# Fallback de capacidade do postgres-volume (em bytes) só usado pelo
# coletor quando a Railway CLI não devolve a capacidade real — nunca
# inventa um valor sem essa configuração explícita.
# RAILWAY_VOLUME_FALLBACK_CAPACITY_BYTES=
